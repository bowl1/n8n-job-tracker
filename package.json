{
  "name": "n8n-job-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "api": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "profiles:load": "tsx scripts/load-profiles.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "LLM_ENABLED=false NODE_ENV=test node --import tsx --test tests/*.integration.ts",
    "jobs:reevaluate": "node --import tsx scripts/reevaluate.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "franc": "^6.2.0",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.1"
  }
}
